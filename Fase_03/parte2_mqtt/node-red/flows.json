  {
    "id": "avaliar",
    "type": "function",
    "z": "aba_cardioia",
    "name": "Avaliar leitura",
    "func": "// Mesmos limites usados no firmware\nconst TEMP_FEBRE = 38.0;\nconst TEMP_HIPOTERMIA = 35.0;\nconst BPM_TAQUICARDIA = 120;\nconst BPM_BRADICARDIA = 50;\n\nconst d = msg.payload;\nif (typeof d !== 'object' || d.bpm === undefined || d.temp === undefined) {\n    node.warn('mensagem fora do formato esperado');\n    return null;\n}\n\n// leituras do buffer chegam com o horário em que foram coletadas\nconst instante = d.ts > 0 ? d.ts * 1000 : Date.now();\n\nconst alertas = [];\nif (d.bpm > BPM_TAQUICARDIA) alertas.push('Taquicardia (' + d.bpm + ' bpm)');\nif (d.bpm > 0 && d.bpm < BPM_BRADICARDIA) alertas.push('Bradicardia (' + d.bpm + ' bpm)');\nif (d.temp >= TEMP_FEBRE) alertas.push('Febre (' + d.temp + ' °C)');\nif (d.temp < TEMP_HIPOTERMIA) alertas.push('Temperatura baixa (' + d.temp + ' °C)');\n\nlet status;\nif (alertas.length > 0) {\n    status = { payload: 'ALERTA: ' + alertas.join(' | '), cor: '#e53935' };\n} else if (d.bpm === 0) {\n    status = { payload: 'Sem leitura de pulso', cor: '#fbc02d' };\n} else {\n    status = { payload: 'Sinais dentro do normal', cor: '#43a047' };\n}\n\nconst hora = new Date(instante).toLocaleTimeString('pt-BR');\nconst info = {\n    payload: '#' + d.id + ' às ' + hora + (d.origem === 'buffer' ? ' (sincronizada do buffer)' : ' (tempo real)')\n};\n\nreturn [\n    { topic: 'BPM', payload: d.bpm, timestamp: instante },\n    { topic: 'Temperatura', payload: d.temp, timestamp: instante },\n    { payload: d.temp },\n    { payload: d.umid },\n    status,\n    info\n];",
    "outputs": 6,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 320,
    "y": 160,
    "wires": [
      [
        "chart_bpm"
      ],
      [
        "chart_temp"
      ],
      [
        "gauge_temp"
      ],
      [
        "gauge_umid"
      ],
      [
        "led_alerta"
      ],
      [
        "txt_ultima"
      ]
    ]
  },
